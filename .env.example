OPENAI_API_KEY=your_cerebras_or_openai_api_key_here
OPENAI_BASE_URL=https://api.cerebras.ai/v1
OPENAI_MODEL=llama3.1-8b # or llama3.1-70b, gpt-oss-120b, etc.

SPREADSHEET_ID=your_spreadsheet_id_here

GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_smtp_password_here
SENDER_EMAIL=your_email@gmail.com
RECEIVER_EMAIL=your_email@gmail.com

# Set to true to run the scout pipeline without writing results back to Google Sheets.
# Email report and JSON result files are still generated normally.
SCOUT_DRY_RUN=false